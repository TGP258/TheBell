    "@capacitor/share": "^7.0.4",
    "@capacitor/status-bar": "^7.0.6",
    "lucide-vue-next": "^0.577.0",
    "pinia": "^4.1.0",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@capacitor/android": "^7.6.10",
    "@capacitor/cli": "^7.6.10",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/tsconfig": "^0.9.1",
