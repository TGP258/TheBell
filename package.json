  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "sync": "npm run build && cap sync android",
    "android": "npm run sync && cd android && ./gradlew assembleDevDebug",
